# 9Router + Tailscale — environment template
# Copy to .env and fill with your own values. NEVER commit .env.

# --- 9Router core (required) ---
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
NODE_ENV=production
PORT=20128
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=http://9router:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com
ENABLE_REQUEST_LOGS=true
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=false

# Recommended security/ops (optional but useful)
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
OBSERVABILITY_ENABLED=true
# Server-side preferred aliases for cloud sync:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com

# --- Tailscale sidecar (required) ---
# Generate in Tailscale admin console: Settings -> Keys -> Generate auth key
TS_AUTHKEY=tskey-auth-xxxxxxxx-xxxxxxxxxxxxxxxxx
# Optional tailscale up flags, e.g. --advertise-tags=tag:server
TS_EXTRA_ARGS=

# --- Optional outbound proxy for upstream provider calls ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- Optional SearXNG for the built-in web-search provider ---
# SEARXNG_URL=http://searxng:8080/search